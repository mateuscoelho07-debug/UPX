{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"pnpm server\" \"vite\"",
    "dev:web": "vite",
    "server": "node --experimental-strip-types --no-warnings server/index.ts",
    "start": "vite build && node --experimental-strip-types --no-warnings server/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "test:api": "node --experimental-strip-types --no-warnings --test server/api.test.ts",
    "format": "oxfmt",
    "typecheck": "tsc -p . && tsc -p server"
  },
  "dependencies": {
    "express": "^4.22.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^4.17.25",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.2.5",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  },
  "engines": {
    "node": ">=22.18"
  }
}
