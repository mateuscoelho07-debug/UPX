{
  "name": "rotau",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "ng serve",
    "build": "ng build",
    "start": "ng build && node dist/rotau/server/server.mjs",
    "serve:ssr": "node dist/rotau/server/server.mjs",
    "test": "ng test --watch=false",
    "test:api": "node --experimental-strip-types --no-warnings --test src/server/api.test.ts src/server/route.test.ts",
    "typecheck": "ngc -p tsconfig.app.json && tsc -p tsconfig.spec.json"
  },
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-server": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@angular/ssr": "^22.2.3",
    "@libsql/client": "^0.18.0",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/express": "^5.0.1",
    "@types/node": "^24.0.0",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "24.x"
  }
}
